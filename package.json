{
    "name": "cless-player",
    "version": "3.13.1",
    "description": "CLESS Player",
    "main": "index.js",
    "license": "ISC",
    "scripts": {
        "start": "electron .",
        "test": "node --test test/*.test.js",
        "win32": "electron-builder --win --ia32",
        "win64": "electron-builder --win --x64",
        "ubuntu32": "electron-builder --linux --ia32",
        "ubuntu64": "electron-builder --linux --x64",
        "build": "cd mobile && npm install && npm run build:mobile && npx cap sync android",
        "build:mobile": "cd mobile && npm install && npm run build:mobile",
        "install:mobile": "cd mobile && npm install"
    },
    "homepage": "https://github.com/CLT-SG/CLT-CLESS-Player",
    "repository": {
        "type": "git",
        "url": "https://github.com/CLT-SG/CLT-CLESS-Player.git"
    },
    "author": {
        "name": "Closed-Loop Technology Pte. Ltd",
        "email": "sales@closed-loop.biz"
    },
    "dependencies": {
        "@electron/remote": "^2.1.1",
        "@maximegris/node-websockify": "^1.0.7",
        "auto-launch": "^5.0.5",
        "axios": "^1.13.2",
        "cors": "^2.8.5",
        "crypto-js": "^4.1.1",
        "date-and-time": "^3.5.0",
        "electron-log": "^3.0.6",
        "electron-shutdown-command": "^2.0.1",
        "electron-updater": "^6.6.2",
        "express": "^4.17.2",
        "express-csp-header": "^5.1.0",
        "ip": "^2.0.1",
        "is-reachable": "^5.2.1",
        "macaddress": "^0.5.2",
        "mkcert": "^1.5.0",
        "path": "^0.12.7",
        "ping": "^0.4.2",
        "qrcode": "^1.5.0",
        "socket.io": "^4.5.0",
        "socket.io-client": "^4.8.1",
        "systeminformation": "^5.23.5",
        "xml-js": "^1.6.11"
    },
    "optionalDependencies": {
        "win-audio": "^3.0.5"
    },
    "devDependencies": {
        "electron": "^44.4.5",
        "electron-builder": "^22.3.3"
    },
    "build": {
        "appId": "cless.player.app",
        "productName": "eCLESS_Player",
        "asar": true,
        "extraResources": [
            {
                "from": "./cert",
                "to": "cert",
                "filter": [
                    "**/*",
                    "!csr.pem"
                ]
            }
        ],
        "files": [
            "**/*",
            "!cert",
            "!cert/**/*",
            "!build/release",
            "!build/release/**/*"
        ],
        "directories": {
            "output": "build/release"
        },
        "compression": "maximum",
        "publish": [
            {
                "provider": "github",
                "owner": "CLT-SG",
                "repo": "CLT-CLESS-Player",
                "releaseType": "release"
            }
        ],
        "win": {
            "target": "nsis",
            "artifactName": "${productName}_Setup_${version}_Win7Above_${arch}.exe",
            "icon": "build/icons/win/clt.png",
            "legalTrademarks": "Copyright by Closed-loop Technology Pte Ltd. All rights reserved"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "differentialPackage": true
        },
        "linux": {
            "target": [
                "deb",
                "AppImage"
            ],
            "artifactName": "${productName}_${version}_${arch}.${ext}",
            "icon": "build/icons/linux",
            "category": "AudioVideo",
            "desktop": "eClessplayer"
        }
    }
}
