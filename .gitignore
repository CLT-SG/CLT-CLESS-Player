# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release
build/builder-debug.yml

# Dependency directory
# Commenting this out is preferred by some people, see
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git-
node_modules
.vscode

# Users Environment Variables
.lock-wscript
*.m4s
*.m3u8
*.ts
*.mp4
*.mpd

# The *.ts rule above targets MPEG-TS media segments. TypeScript sources in the
# modern renderer and the shared core must stay tracked.
!app/**/*.ts
!src/core/**/*.ts

# Build output of the modern renderer (produced by `npm --prefix app run build`)
src/app-dist/
# Copy of the above, placed by mobile/build-mobile.cjs
mobile/www/app-dist/

#package-lock.json
package-lock.json