{
  "name": "ecless-player-mobile",
  "version": "3.2.9",
  "type": "module",
  "description": "eCLESS Player Mobile App - Android & iOS",
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "license": "ISC",
  "homepage": "www.closed-loop.biz",
  "scripts": {
    "build:datetime": "npx rollup -c rollup.datetime.config.js",
    "build:android": "npm run build:datetime && npx cap sync android && npx cap open android",
    "build:ios": "npm run build:datetime && npx cap sync ios && npx cap open ios",
    "sync": "npm run build:datetime && npx cap sync",
    "sync:android": "npm run build:datetime && npx cap sync android",
    "sync:ios": "npm run build:datetime && npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "clean": "rm -rf www/* android ios",
    "generate:icons": "npx @capacitor/assets generate --android",
    "generate:icons:all": "npx @capacitor/assets generate"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/device": "^6.0.1",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/network": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "axios": "^1.7.7",
    "date-and-time": "^4.1.1",
    "qrcode": "^1.5.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.53.3"
  }
}
