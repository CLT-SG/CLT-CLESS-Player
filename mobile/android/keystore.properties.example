# Android Keystore Configuration
# Copy this file to keystore.properties and fill in your keystore details
# NEVER commit keystore.properties to version control!

# Path to your keystore file (relative to android/ directory)
storeFile=ecless-player-release.keystore

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias
keyAlias=ecless-player-key

# Key password
keyPassword=YOUR_KEY_PASSWORD
