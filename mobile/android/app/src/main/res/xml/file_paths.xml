<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External storage root directory -->
    <external-path 
        name="external_files" 
        path="." />
    
    <!-- App-specific external storage directory -->
    <external-files-path 
        name="app_external_files" 
        path="." />
    
    <!-- App-specific cache directory -->
    <cache-path 
        name="cache_files" 
        path="." />
    
    <!-- Internal storage files directory -->
    <files-path 
        name="internal_files" 
        path="." />
    
    <!-- Downloads directory (for Android 11+) -->
    <external-path 
        name="download_files" 
        path="Download" />
    
    <!-- Documents directory -->
    <external-path 
        name="documents_files" 
        path="Documents" />
</paths>