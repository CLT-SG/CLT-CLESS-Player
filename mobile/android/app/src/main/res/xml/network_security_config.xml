<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow all HTTP and HTTPS traffic for eCLESS Player -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Specific domain configurations for eCLESS servers -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">closed-loop.biz</domain>
        <domain includeSubdomains="true">cless4.closed-loop.biz</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
</network-security-config>
